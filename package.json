{
  "name": "qatestge",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "pnpm --parallel --stream --filter qatestge --filter @qatestge/api run dev",
    "dev:frontend": "vite",
    "dev:backend": "pnpm --dir backend dev",
    "dev:api": "pnpm --dir backend dev",
    "build:frontend": "tsc --noEmit && vite build",
    "build:backend": "pnpm --dir backend build",
    "build": "tsc --noEmit && vite build && tsc -p backend/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
