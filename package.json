{
  "name": "qatestge",
  "private": true,
  "version": "1.1.0",
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --stream --filter qatestge --filter @qatestge/api run dev:workspace",
    "db:check": "pnpm --dir backend db:check",
    "db:migrate": "pnpm --dir backend db:migrate",
    "dev:all": "pnpm dev",
    "dev:frontend": "vite",
    "dev:workspace": "vite",
    "dev:backend": "pnpm --dir backend dev",
    "dev:api": "pnpm --dir backend dev",
    "build:frontend": "tsc --noEmit && vite build",
    "build:backend": "pnpm --dir backend build",
    "build": "tsc --noEmit && vite build && tsc -p backend/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.11"
  }
}
