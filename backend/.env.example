# Solo servidor. No usar prefijos VITE_ para estas variables.
PORT=3000
DATABASE_URL=postgresql://qa_user:replace-me@localhost:5432/qa_test_ge
CORS_ORIGIN=http://localhost:5173
# FRONTEND_ORIGIN también es válido y tiene prioridad sobre CORS_ORIGIN.
# JWT_SECRET no se utiliza: las sesiones opacas se revocan en PostgreSQL.

# NODE_ENV=production activa cookies Secure; usar HTTPS.
# API_ORIGIN=https://api.example.com (origen directo para SwaggerUI si difiere del frontend)

# Piloto Playwright opcional. Configura los tres valores para habilitar la publicación.
# PLAYWRIGHT_PROJECT_ID=1
# PLAYWRIGHT_ACTOR_ID=2
# PLAYWRIGHT_TOKEN_SHA256=<sha256 en hexadecimal del secreto de CI>

# Activación y recuperación opcionales. Configura las tres variables en el servidor.
# ACCOUNT_LINK_APP_URL=https://qa.example.com/
# ACCOUNT_LINK_WEBHOOK_URL=https://mail.example.com/account-link
# ACCOUNT_LINK_WEBHOOK_TOKEN=<secreto-del-webhook>
