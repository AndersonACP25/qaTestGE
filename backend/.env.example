# Solo servidor. No usar prefijos VITE_ para estas variables.
PORT=3000
DATABASE_URL=postgresql://qa_user:replace-me@localhost:5432/qa_test_ge
CORS_ORIGIN=http://localhost:5173
# FRONTEND_ORIGIN también es válido y tiene prioridad sobre CORS_ORIGIN.
# JWT_SECRET no se utiliza: las sesiones opacas se revocan en PostgreSQL.

# NODE_ENV=production activa cookies Secure; usar HTTPS.
# API_ORIGIN=https://api.example.com (origen directo para SwaggerUI si difiere del frontend)
